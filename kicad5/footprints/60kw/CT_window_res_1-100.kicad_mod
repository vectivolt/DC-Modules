(module CT_window_res_1-100 (layer F.Cu) (tedit 0)
  (descr "Resonant CT 1:100 on a 10 mm toroid, in series with the tank, 2.0 R burden — APPROXIMATE envelope. Core OD16/ID10/H8 mm per docs/magnetics.md; finished OD 24 mm incl. winding build, stack height ~14 mm. 1 winding(s), 0.5 mm2 conductor -> 2 mm lead holes. Wind to this size. Generated by calculations/footprint-gen.mjs.")
  (fp_text reference REF** (at 0 -15) (layer F.SilkS) (effects (font (size 1.2 1.2) (thickness 0.2))))
  (fp_text value CT_window_res_1-100 (at 0 15.0) (layer F.Fab) (effects (font (size 1.2 1.2) (thickness 0.2))))
  (fp_circle (center 0 0) (end 12.00 0) (layer F.SilkS) (width 0.2))
  (fp_circle (center 0 0) (end 5.00 0) (layer F.SilkS) (width 0.15))
  (fp_circle (center 0 0) (end 14 0) (layer F.CrtYd) (width 0.05))
  (pad 1 thru_hole rect (at 6.5 -2.2) (size 2.9 2.9) (drill 2) (layers *.Cu *.Mask))
  (pad 2 thru_hole circle (at 6.5 2.2) (size 2.9 2.9) (drill 2) (layers *.Cu *.Mask))
)
