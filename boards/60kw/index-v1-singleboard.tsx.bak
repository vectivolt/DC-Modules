// 60 kW monoblock main PCB — ONE board: 2 interleaved Vienna lanes (0/180°) + 2× 3-phase LLC
// channels, shared split bus, shared banks, one S/P matrix, 2 MCUs (E16). Cells identical to 30 kW.
import {
  ViennaPhase, LlcHalfBridgeLeg, LlcSection, SplitDcLink, SeriesParallelRelayMatrix,
  HvDivider, ControlMcu, StudFP, RelayFP, FilmBoxFP, ChokeFP,
} from "../../packages/power-primitives/cells";

const PH = [
  { id: "A0", ac: "net.AC1F", y: 135 }, { id: "B0", ac: "net.AC2", y: 80 }, { id: "C0", ac: "net.AC3", y: 25 },
  { id: "A1", ac: "net.AC1F", y: -30 }, { id: "B1", ac: "net.AC2", y: -85 }, { id: "C1", ac: "net.AC3", y: -140 },
];
const LEGS = [
  { id: "1", sw: "net.SW1", y: 150 }, { id: "2", sw: "net.SW2", y: 105 }, { id: "3", sw: "net.SW3", y: 60 },
  { id: "4", sw: "net.SW4", y: 15 }, { id: "5", sw: "net.SW5", y: -30 }, { id: "6", sw: "net.SW6", y: -75 },
];
const SECS = [
  { id: "1", sw: "net.SW1", star: "net.STAR0", x: 105, y: 45 }, { id: "2", sw: "net.SW2", star: "net.STAR0", x: 145, y: 45 }, { id: "3", sw: "net.SW3", star: "net.STAR0", x: 185, y: 45 },
  { id: "4", sw: "net.SW4", star: "net.STAR1", x: 105, y: -205 }, { id: "5", sw: "net.SW5", star: "net.STAR1", x: 145, y: -205 }, { id: "6", sw: "net.SW6", star: "net.STAR1", x: 185, y: -205 },
];

export default () => (
  <board width="560mm" height="480mm" routingDisabled>
    {["ACL1", "ACL2", "ACL3", "PE"].map((n, i) => (
      <chip key={n} name={`J${n}`} footprint={<StudFP />} pinLabels={{ pin1: "P" }} pcbX={-260} pcbY={120 - i * 40} schX={-22} schY={-6 + i * 2} />
    ))}
    {[0, 1, 2].map(i => (
      <chip key={i} name={`F${i + 1}`} footprint={FilmBoxFP(30)} pinLabels={{ pin1: "A", pin2: "B" }} pcbX={-235} pcbY={110 - i * 30} schX={-20} schY={-6 + i * 2} />
    ))}
    {[0, 1, 2].map(i => (
      <chip key={i} name={`MOV${i + 1}`} footprint={FilmBoxFP(10)} pinLabels={{ pin1: "A", pin2: "B" }} pcbX={-235} pcbY={0 - i * 15} schX={-20} schY={2 + i} />
    ))}
    <chip name="CMC1" footprint={<ChokeFP />} pinLabels={{ pin1: "A", pin2: "B" }} pcbX={-200} pcbY={85} schX={-18} schY={-5} />
    <chip name="CMC2" footprint={<ChokeFP />} pinLabels={{ pin1: "A", pin2: "B" }} pcbX={-200} pcbY={-5} schX={-18} schY={-1} />
    {[0, 1, 2].map(i => (
      <capacitor key={i} name={`CX${i + 1}`} capacitance="2.2uF" footprint={FilmBoxFP(27.5)} pcbX={-170} pcbY={100 - i * 25} schX={-16} schY={-5 + i} />
    ))}
    {[0, 1, 2, 3].map(i => (
      <capacitor key={i} name={`CY${i + 1}`} capacitance="4.7nF" footprint={FilmBoxFP(10)} pcbX={-170} pcbY={10 - i * 12} schX={-16} schY={0 + i * 0.6} />
    ))}
    <chip name="KPRE" footprint={<RelayFP />} pinLabels={{ coil1: "C1", coil2: "C2", a: "A", b: "B" }} pcbX={-140} pcbY={115} schX={-14} schY={-6} />
    <resistor name="RPRE" resistance="33" footprint="2512" pcbX={-140} pcbY={95} schX={-14} schY={-4.8} />
    <trace from=".JACL1 > .P" to=".F1 > .A" />
    <trace from=".JACL2 > .P" to=".F2 > .A" />
    <trace from=".JACL3 > .P" to=".F3 > .A" />
    <trace from=".F1 > .B" to="net.LF1" />
    <trace from=".F2 > .B" to="net.LF2" />
    <trace from=".F3 > .B" to="net.LF3" />
    <trace from=".MOV1 > .A" to="net.LF1" />
    <trace from=".MOV1 > .B" to="net.LF2" />
    <trace from=".MOV2 > .A" to="net.LF2" />
    <trace from=".MOV2 > .B" to="net.LF3" />
    <trace from=".MOV3 > .A" to="net.LF3" />
    <trace from=".MOV3 > .B" to="net.LF1" />
    <trace from=".CMC1 > .A" to="net.LF1" />
    <trace from=".CMC1 > .B" to="net.AC1" />
    <trace from=".CMC2 > .A" to="net.LF2" />
    <trace from=".CMC2 > .B" to="net.AC2" />
    <trace from=".CX1 > .pin1" to="net.AC1" />
    <trace from=".CX1 > .pin2" to="net.AC2" />
    <trace from=".CX2 > .pin1" to="net.AC2" />
    <trace from=".CX2 > .pin2" to="net.AC3" />
    <trace from=".CX3 > .pin1" to="net.AC3" />
    <trace from=".CX3 > .pin2" to="net.AC1" />
    <trace from=".CY1 > .pin1" to="net.AC1" />
    <trace from=".CY1 > .pin2" to="net.PE" />
    <trace from=".CY2 > .pin1" to="net.AC2" />
    <trace from=".CY2 > .pin2" to="net.PE" />
    <trace from=".JPE > .P" to="net.PE" />
    <trace from=".LF3" to="net.AC3" />
    <trace from=".KPRE > .A" to="net.AC1" />
    <trace from=".KPRE > .B" to="net.AC1F" />
    <trace from=".RPRE > .pin1" to="net.AC1" />
    <trace from=".RPRE > .pin2" to="net.AC1F" />

    {PH.map(p => (
      <ViennaPhase key={p.id} id={p.id} ac={p.ac} dcp="net.DCP" dcn="net.DCN" mid="net.MID" pcbX={-100} pcbY={p.y} schX={-10} schY={-6 + PH.indexOf(p) * 2} />
    ))}
    <SplitDcLink id="0" nPerHalf={5} dcp="net.DCP" dcn="net.DCN" mid="net.MID" pcbX={-250} pcbY={-160} schX={-4} schY={-7} />
    <SplitDcLink id="1" nPerHalf={4} dcp="net.DCP" dcn="net.DCN" mid="net.MID" pcbX={-250} pcbY={-35} schX={-4} schY={-5} />

    {LEGS.map(l => (
      <LlcHalfBridgeLeg key={l.id} id={l.id} bus="net.DCP" gnd="net.DCN" sw={l.sw} pcbX={55} pcbY={l.y} schX={2} schY={-7 + LEGS.indexOf(l) * 2} />
    ))}
    {SECS.map(sc => (
      <LlcSection key={sc.id} id={sc.id} sw={sc.sw} star={sc.star} bkAp="net.BKAP" bkAn="net.BKAN" bkBp="net.BKBP" bkBn="net.BKBN" pcbX={sc.x} pcbY={sc.y} schX={6 + (SECS.indexOf(sc) % 3) * 4} schY={sc.y > 0 ? -7 : 1} />
    ))}

    {[0, 1, 2, 3].map(i => (
      <capacitor key={`a${i}`} name={`CBA${i}`} capacitance="470uF" footprint={FilmBoxFP(10)} pcbX={240 + (i % 2) * 20} pcbY={40 - Math.floor(i / 2) * 20} schX={18} schY={-4 + i * 0.6} />
    ))}
    {[0, 1, 2, 3].map(i => (
      <capacitor key={`b${i}`} name={`CBB${i}`} capacitance="470uF" footprint={FilmBoxFP(10)} pcbX={240 + (i % 2) * 20} pcbY={-10 - Math.floor(i / 2) * 20} schX={18} schY={-1 + i * 0.6} />
    ))}
    {[0, 1, 2, 3].map(i => [
      <trace key={`ap${i}`} from={`.CBA${i} > .pin1`} to="net.BKAP" />,
      <trace key={`an${i}`} from={`.CBA${i} > .pin2`} to="net.BKAN" />,
      <trace key={`bp${i}`} from={`.CBB${i} > .pin1`} to="net.BKBP" />,
      <trace key={`bn${i}`} from={`.CBB${i} > .pin2`} to="net.BKBN" />,
    ])}

    <SeriesParallelRelayMatrix bkAp="net.BKAP" bkAn="net.BKAN" bkBp="net.BKBP" bkBn="net.BKBN" outp="net.OUTP" outn="net.OUTN" pcbX={95} pcbY={-150} schX={6} schY={5} />
    <chip name="JOUTP" footprint={<StudFP />} pinLabels={{ pin1: "P" }} pcbX={255} pcbY={-120} schX={16} schY={5} />
    <chip name="JOUTN" footprint={<StudFP />} pinLabels={{ pin1: "P" }} pcbX={255} pcbY={-145} schX={16} schY={6} />
    <trace from=".JOUTP > .P" to="net.OUTP" />
    <trace from=".JOUTN > .P" to="net.OUTN" />
    <chip name="QDIS" footprint="to220" pinLabels={{ pin1: "G", pin2: "D", pin3: "S" }} pcbX={-20} pcbY={-235} schX={-2} schY={5} />
    {[0, 1, 2, 3].map(i => (
      <resistor key={i} name={`RDIS${i}`} resistance="160" footprint="2512" pcbX={-10 + i * 8} pcbY={-235} schX={-1 + i * 0.5} schY={5} />
    ))}
    <trace from=".RDIS0 > .pin1" to="net.DCP" />
    <trace from=".RDIS0 > .pin2" to=".RDIS1 > .pin1" />
    <trace from=".RDIS1 > .pin2" to=".RDIS2 > .pin1" />
    <trace from=".RDIS2 > .pin2" to=".RDIS3 > .pin1" />
    <trace from=".RDIS3 > .pin2" to=".QDIS > .D" />
    <trace from=".QDIS > .S" to="net.DCN" />

    <HvDivider id="BP" hv="net.DCP" lv="net.SNS_VBUSP" gnd="net.DGND" pcbX={-40} pcbY={-160} schX={-10} schY={6} />
    <HvDivider id="BM" hv="net.MID" lv="net.SNS_VMID" gnd="net.DGND" pcbX={-40} pcbY={-167} schX={-10} schY={6.8} />
    <HvDivider id="OA" hv="net.BKAP" lv="net.SNS_VBKA" gnd="net.DGND" pcbX={-40} pcbY={-174} schX={-5} schY={6} />
    <HvDivider id="OB" hv="net.BKBP" lv="net.SNS_VBKB" gnd="net.DGND" pcbX={-40} pcbY={-181} schX={-5} schY={6.8} />
    <HvDivider id="OV" hv="net.OUTP" lv="net.SNS_VOUT" gnd="net.DGND" pcbX={-40} pcbY={-188} schX={0} schY={6} />
    <chip name="RSH_OUT" footprint={FilmBoxFP(20)} pinLabels={{ pin1: "A", pin2: "B" }} pcbX={-105} pcbY={-215} schX={12} schY={6} />
    <chip name="USH_OUT" footprint="soic8" pinLabels={{ pin1: "VIN+", pin2: "VIN-", pin3: "GND1", pin4: "VDD1", pin5: "VDD2", pin6: "OUTP", pin7: "OUTN", pin8: "GND2" }} pcbX={-105} pcbY={-228} schX={12} schY={7} />
    <trace from=".RSH_OUT > .A" to="net.OUTN_SH" />
    <trace from=".RSH_OUT > .B" to="net.OUTN" />
    <trace from=".USH_OUT > .VIN+" to="net.OUTN_SH" />
    <trace from=".USH_OUT > .VIN-" to="net.OUTN" />
    {["A", "B", "C"].map((p, i) => [
      <chip key={`sh${p}`} name={`RSH_${p}`} footprint={FilmBoxFP(15)} pinLabels={{ pin1: "A", pin2: "B" }} pcbX={-40 + i * 25} pcbY={-200} schX={-14 + i} schY={6} />,
      <chip key={`ua${p}`} name={`USH_${p}`} footprint="soic8" pinLabels={{ pin1: "VIN+", pin2: "VIN-", pin3: "GND1", pin4: "VDD1", pin5: "VDD2", pin6: "OUTP", pin7: "OUTN", pin8: "GND2" }} pcbX={-40 + i * 25} pcbY={-215} schX={-14 + i} schY={7} />,
      <trace key={`t1${p}`} from={`.RSH_${p} > .A`} to={`net.AC${i + 1}${i === 0 ? "F" : ""}`} />,
      <trace key={`t2${p}`} from={`.USH_${p} > .VIN+`} to={`.RSH_${p} > .A`} />,
      <trace key={`t3${p}`} from={`.USH_${p} > .VIN-`} to={`.RSH_${p} > .B`} />,
    ])}

    <ControlMcu id="PFC" pcbX={-240} pcbY={-230} schX={-16} schY={9} />
    <ControlMcu id="LLC" pcbX={-175} pcbY={-230} schX={-10} schY={9} />
    <chip name="UCAN" footprint="soic8" pinLabels={{ pin1: "TXD", pin2: "GND1", pin3: "RXD", pin4: "VDD1", pin5: "VDD2", pin6: "CANL", pin7: "CANH", pin8: "GND2" }} pcbX={50} pcbY={-230} schX={-5} schY={9} />
    <chip name="JCAN" footprint="pinrow4" pcbX={70} pcbY={-230} schX={-3} schY={9} />
    <trace from=".UCAN > .CANH" to=".JCAN > .pin1" />
    <trace from=".UCAN > .CANL" to=".JCAN > .pin2" />
    <trace from=".UCAN > .TXD" to=".ULLC > .pin61" />
    <trace from=".UCAN > .RXD" to=".ULLC > .pin62" />
    <trace from=".UPFC > .pin68" to=".ULLC > .pin68" />
    <trace from=".UPFC > .pin69" to=".ULLC > .pin69" />
    <chip name="UAUX" footprint="soic8" pinLabels={{ pin1: "VIN", pin2: "GND", pin3: "FB", pin4: "COMP", pin5: "CS", pin6: "GATE", pin7: "VCC", pin8: "NC" }} pcbX={95} pcbY={-230} schX={0} schY={9} />
    <chip name="TAUX" footprint={<XfmrAux />} pinLabels={{ pin1: "P1", pin2: "P2", pin3: "S1", pin4: "S2", pin5: "S3", pin6: "S4" }} pcbX={120} pcbY={-230} schX={2} schY={9} />
    {[0, 1].map(i => (
      <chip key={i} name={`JFAN${i + 1}`} footprint="pinrow4" pcbX={155 + i * 20} pcbY={-230} schX={5 + i} schY={9} />
    ))}
    <trace from=".UAUX > .GATE" to=".TAUX > .P2" />
    <trace from=".TAUX > .P1" to="net.DCP" />
  </board>
);

const XfmrAux = () => (
  <footprint>
    {[0, 1, 2, 3, 4, 5].map(i => (
      <platedhole key={i} portHints={[`pin${i + 1}`]} pcbX={-7.5 + (i % 3) * 7.5} pcbY={i < 3 ? -6 : 6} holeDiameter="1.1mm" outerDiameter="2mm" shape="circle" />
    ))}
  </footprint>
);
