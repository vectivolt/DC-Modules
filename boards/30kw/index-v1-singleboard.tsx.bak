// 30 kW monoblock main PCB — single board, 1 Vienna lane + 1× 3-phase LLC channel (E16).
// Floorplan per §31: front (x−) AC/EMI → chokes → PFC semis row → DC link → LLC legs →
// tanks/transformers → rectifiers/banks → S/P + output (x+). Control strip along y− edge.
// Routing status: nets + placement complete; power routing via busbar/plane strategy documented in
// docs/pcb-routing-status.md — autorouting deliberately disabled for the power stage (§41).
import {
  ViennaPhase, LlcHalfBridgeLeg, LlcSection, SplitDcLink, SeriesParallelRelayMatrix,
  HvDivider, ControlMcu, StudFP, RelayFP, FilmBoxFP, ChokeFP,
} from "../../packages/power-primitives/cells";

export default () => (
  <board width="400mm" height="340mm" routingDisabled>
    {/* ---------- AC input, surge, EMI (§26/§27) ---------- */}
    {["ACL1", "ACL2", "ACL3", "PE"].map((n, i) => (
      <chip key={n} name={`J${n}`} footprint={<StudFP />} pinLabels={{ pin1: "P" }} pcbX={-185} pcbY={80 - i * 40} schX={-22} schY={-6 + i * 2} />
    ))}
    {[0, 1, 2].map(i => (
      <chip key={i} name={`F${i + 1}`} footprint={FilmBoxFP(30)} pinLabels={{ pin1: "A", pin2: "B" }} pcbX={-160} pcbY={70 - i * 30} schX={-20} schY={-6 + i * 2} />
    ))}
    {[0, 1, 2].map(i => (
      <chip key={i} name={`MOV${i + 1}`} footprint={FilmBoxFP(10)} pinLabels={{ pin1: "A", pin2: "B" }} pcbX={-160} pcbY={-40 - i * 15} schX={-20} schY={2 + i} />
    ))}
    <chip name="CMC1" footprint={<ChokeFP />} pinLabels={{ pin1: "A", pin2: "B" }} pcbX={-125} pcbY={45} schX={-18} schY={-5} />
    <chip name="CMC2" footprint={<ChokeFP />} pinLabels={{ pin1: "A", pin2: "B" }} pcbX={-125} pcbY={-45} schX={-18} schY={-1} />
    {[0, 1, 2].map(i => (
      <capacitor key={i} name={`CX${i + 1}`} capacitance="2.2uF" footprint={FilmBoxFP(27.5)} pcbX={-95} pcbY={60 - i * 25} schX={-16} schY={-5 + i} />
    ))}
    {[0, 1, 2, 3].map(i => (
      <capacitor key={i} name={`CY${i + 1}`} capacitance="4.7nF" footprint={FilmBoxFP(10)} pcbX={-95} pcbY={-30 - i * 12} schX={-16} schY={0 + i * 0.6} />
    ))}
    {/* precharge: relay bypass + 33R (E14) */}
    <chip name="KPRE" footprint={<RelayFP />} pinLabels={{ coil1: "C1", coil2: "C2", a: "A", b: "B" }} pcbX={-65} pcbY={75} schX={-14} schY={-6} />
    <resistor name="RPRE" resistance="33" footprint="2512" pcbX={-65} pcbY={55} schX={-14} schY={-4.8} />
    <trace from=".JACL1 > .P" to=".F1 > .A" />
    <trace from=".JACL2 > .P" to=".F2 > .A" />
    <trace from=".JACL3 > .P" to=".F3 > .A" />
    <trace from=".F1 > .B" to="net.LF1" />
    <trace from=".F2 > .B" to="net.LF2" />
    <trace from=".F3 > .B" to="net.LF3" />
    <trace from=".MOV1 > .A" to="net.LF1" />
    <trace from=".MOV1 > .B" to="net.LF2" />
    <trace from=".MOV2 > .A" to="net.LF2" />
    <trace from=".MOV2 > .B" to="net.LF3" />
    <trace from=".MOV3 > .A" to="net.LF3" />
    <trace from=".MOV3 > .B" to="net.LF1" />
    <trace from=".CMC1 > .A" to="net.LF1" />
    <trace from=".CMC1 > .B" to="net.AC1" />
    <trace from=".CMC2 > .A" to="net.LF2" />
    <trace from=".CMC2 > .B" to="net.AC2" />
    <trace from=".CX1 > .pin1" to="net.AC1" />
    <trace from=".CX1 > .pin2" to="net.AC2" />
    <trace from=".CX2 > .pin1" to="net.AC2" />
    <trace from=".CX2 > .pin2" to="net.AC3" />
    <trace from=".CX3 > .pin1" to="net.AC3" />
    <trace from=".CX3 > .pin2" to="net.AC1" />
    <trace from=".CY1 > .pin1" to="net.AC1" />
    <trace from=".CY1 > .pin2" to="net.PE" />
    <trace from=".CY2 > .pin1" to="net.AC2" />
    <trace from=".CY2 > .pin2" to="net.PE" />
    <trace from=".JPE > .P" to="net.PE" />
    <trace from=".LF3" to="net.AC3" />
    <trace from=".KPRE > .A" to="net.AC1" />
    <trace from=".KPRE > .B" to="net.AC1F" />
    <trace from=".RPRE > .pin1" to="net.AC1" />
    <trace from=".RPRE > .pin2" to="net.AC1F" />

    {/* ---------- Vienna PFC lane (3 phases) ---------- */}
    <ViennaPhase id="PA" ac="net.AC1F" dcp="net.DCP" dcn="net.DCN" mid="net.MID" pcbX={-30} pcbY={55} schX={-10} schY={-6} />
    <ViennaPhase id="PB" ac="net.AC2" dcp="net.DCP" dcn="net.DCN" mid="net.MID" pcbX={-30} pcbY={0} schX={-10} schY={-1} />
    <ViennaPhase id="PC" ac="net.AC3" dcp="net.DCP" dcn="net.DCN" mid="net.MID" pcbX={-30} pcbY={-55} schX={-10} schY={4} />

    {/* ---------- split DC link ---------- */}
    <SplitDcLink id="0" nPerHalf={5} dcp="net.DCP" dcn="net.DCN" mid="net.MID" pcbX={-30} pcbY={-95} schX={-4} schY={-6} />

    {/* ---------- LLC channel: 3 legs + 3 sections ---------- */}
    <LlcHalfBridgeLeg id="1" bus="net.DCP" gnd="net.DCN" sw="net.SW1" pcbX={75} pcbY={60} schX={2} schY={-6} />
    <LlcHalfBridgeLeg id="2" bus="net.DCP" gnd="net.DCN" sw="net.SW2" pcbX={75} pcbY={10} schX={2} schY={-2} />
    <LlcHalfBridgeLeg id="3" bus="net.DCP" gnd="net.DCN" sw="net.SW3" pcbX={75} pcbY={-40} schX={2} schY={2} />
    <LlcSection id="1" sw="net.SW1" star="net.STAR" bkAp="net.BKAP" bkAn="net.BKAN" bkBp="net.BKBP" bkBn="net.BKBN" pcbX={115} pcbY={35} schX={6} schY={-6} />
    <LlcSection id="2" sw="net.SW2" star="net.STAR" bkAp="net.BKAP" bkAn="net.BKAN" bkBp="net.BKBP" bkBn="net.BKBN" pcbX={150} pcbY={35} schX={10} schY={-6} />
    <LlcSection id="3" sw="net.SW3" star="net.STAR" bkAp="net.BKAP" bkAn="net.BKAN" bkBp="net.BKBP" bkBn="net.BKBN" pcbX={185} pcbY={35} schX={14} schY={-6} />

    {/* bank filter caps */}
    {[0, 1].map(i => (
      <capacitor key={`a${i}`} name={`CBA${i}`} capacitance="470uF" footprint={FilmBoxFP(10)} pcbX={140 + i * 20} pcbY={-60} schX={7 + i} schY={2} />
    ))}
    {[0, 1].map(i => (
      <capacitor key={`b${i}`} name={`CBB${i}`} capacitance="470uF" footprint={FilmBoxFP(10)} pcbX={140 + i * 20} pcbY={-85} schX={7 + i} schY={3.4} />
    ))}
    {[0, 1].map(i => [
      <trace key={`ap${i}`} from={`.CBA${i} > .pin1`} to="net.BKAP" />,
      <trace key={`an${i}`} from={`.CBA${i} > .pin2`} to="net.BKAN" />,
      <trace key={`bp${i}`} from={`.CBB${i} > .pin1`} to="net.BKBP" />,
      <trace key={`bn${i}`} from={`.CBB${i} > .pin2`} to="net.BKBN" />,
    ])}

    {/* ---------- S/P matrix + output ---------- */}
    <SeriesParallelRelayMatrix bkAp="net.BKAP" bkAn="net.BKAN" bkBp="net.BKBP" bkBn="net.BKBN" outp="net.OUTP" outn="net.OUTN" pcbX={90} pcbY={-115} schX={6} schY={5} />
    <chip name="JOUTP" footprint={<StudFP />} pinLabels={{ pin1: "P" }} pcbX={185} pcbY={-140} schX={16} schY={5} />
    <chip name="JOUTN" footprint={<StudFP />} pinLabels={{ pin1: "P" }} pcbX={185} pcbY={-165} schX={16} schY={6} />
    <trace from=".JOUTP > .P" to="net.OUTP" />
    <trace from=".JOUTN > .P" to="net.OUTN" />
    {/* discharge: FET + 4×160R across bus */}
    <chip name="QDIS" footprint="to220" pinLabels={{ pin1: "G", pin2: "D", pin3: "S" }} pcbX={-145} pcbY={-145} schX={-2} schY={5} />
    {[0, 1, 2, 3].map(i => (
      <resistor key={i} name={`RDIS${i}`} resistance="160" footprint="2512" pcbX={-135 + i * 8} pcbY={-145} schX={-1 + i * 0.5} schY={5} />
    ))}
    <trace from=".RDIS0 > .pin1" to="net.DCP" />
    <trace from=".RDIS0 > .pin2" to=".RDIS1 > .pin1" />
    <trace from=".RDIS1 > .pin2" to=".RDIS2 > .pin1" />
    <trace from=".RDIS2 > .pin2" to=".RDIS3 > .pin1" />
    <trace from=".RDIS3 > .pin2" to=".QDIS > .D" />
    <trace from=".QDIS > .S" to="net.DCN" />

    {/* ---------- sensing (§19) ---------- */}
    <HvDivider id="BP" hv="net.DCP" lv="net.SNS_VBUSP" gnd="net.DGND" pcbX={-105} pcbY={-122} schX={-10} schY={6} />
    <HvDivider id="BM" hv="net.MID" lv="net.SNS_VMID" gnd="net.DGND" pcbX={-105} pcbY={-129} schX={-10} schY={6.8} />
    <HvDivider id="OA" hv="net.BKAP" lv="net.SNS_VBKA" gnd="net.DGND" pcbX={20} pcbY={-145} schX={-5} schY={6} />
    <HvDivider id="OB" hv="net.BKBP" lv="net.SNS_VBKB" gnd="net.DGND" pcbX={20} pcbY={-152} schX={-5} schY={6.8} />
    <HvDivider id="OV" hv="net.OUTP" lv="net.SNS_VOUT" gnd="net.DGND" pcbX={50} pcbY={-170} schX={0} schY={6} />
    {/* output shunt + iso amp; phase shunts + iso amps */}
    <chip name="RSH_OUT" footprint={FilmBoxFP(20)} pinLabels={{ pin1: "A", pin2: "B" }} pcbX={120} pcbY={-170} schX={12} schY={6} />
    <chip name="USH_OUT" footprint="soic8" pinLabels={{ pin1: "VIN+", pin2: "VIN-", pin3: "GND1", pin4: "VDD1", pin5: "VDD2", pin6: "OUTP", pin7: "OUTN", pin8: "GND2" }} pcbX={120} pcbY={-185} schX={12} schY={7} />
    <trace from=".RSH_OUT > .A" to="net.OUTN_SH" />
    <trace from=".RSH_OUT > .B" to="net.OUTN" />
    <trace from=".USH_OUT > .VIN+" to="net.OUTN_SH" />
    <trace from=".USH_OUT > .VIN-" to="net.OUTN" />
    {["A", "B", "C"].map((p, i) => [
      <chip key={`sh${p}`} name={`RSH_${p}`} footprint={FilmBoxFP(15)} pinLabels={{ pin1: "A", pin2: "B" }} pcbX={-60 + i * 20} pcbY={-115} schX={-14 + i} schY={6} />,
      <chip key={`ua${p}`} name={`USH_${p}`} footprint="soic8" pinLabels={{ pin1: "VIN+", pin2: "VIN-", pin3: "GND1", pin4: "VDD1", pin5: "VDD2", pin6: "OUTP", pin7: "OUTN", pin8: "GND2" }} pcbX={-40 + i * 20} pcbY={-130} schX={-14 + i} schY={7} />,
      <trace key={`t1${p}`} from={`.RSH_${p} > .A`} to={`net.AC${i + 1}${i === 0 ? "F" : ""}`} />,
      <trace key={`t2${p}`} from={`.USH_${p} > .VIN+`} to={`.RSH_${p} > .A`} />,
      <trace key={`t3${p}`} from={`.USH_${p} > .VIN-`} to={`.RSH_${p} > .B`} />,
    ])}

    {/* ---------- control: 2 MCUs, iso CAN, aux, fans ---------- */}
    <ControlMcu id="PFC" pcbX={-130} pcbY={-160} schX={-16} schY={9} />
    <ControlMcu id="LLC" pcbX={-70} pcbY={-160} schX={-10} schY={9} />
    <chip name="UCAN" footprint="soic8" pinLabels={{ pin1: "TXD", pin2: "GND1", pin3: "RXD", pin4: "VDD1", pin5: "VDD2", pin6: "CANL", pin7: "CANH", pin8: "GND2" }} pcbX={-20} pcbY={-160} schX={-5} schY={9} />
    <chip name="JCAN" footprint="pinrow4" pcbX={0} pcbY={-160} schX={-3} schY={9} />
    <trace from=".UCAN > .CANH" to=".JCAN > .pin1" />
    <trace from=".UCAN > .CANL" to=".JCAN > .pin2" />
    <trace from=".UCAN > .TXD" to=".ULLC > .pin61" />
    <trace from=".UCAN > .RXD" to=".ULLC > .pin62" />
    {/* internal link */}
    <trace from=".UPFC > .pin68" to=".ULLC > .pin68" />
    <trace from=".UPFC > .pin69" to=".ULLC > .pin69" />
    {/* aux power block (integrated flyback — §28; detailed in aux subcircuit doc) */}
    <chip name="UAUX" footprint="soic8" pinLabels={{ pin1: "VIN", pin2: "GND", pin3: "FB", pin4: "COMP", pin5: "CS", pin6: "GATE", pin7: "VCC", pin8: "NC" }} pcbX={20} pcbY={-160} schX={0} schY={9} />
    <chip name="TAUX" footprint={<XfmrAux />} pinLabels={{ pin1: "P1", pin2: "P2", pin3: "S1", pin4: "S2", pin5: "S3", pin6: "S4" }} pcbX={45} pcbY={-160} schX={2} schY={9} />
    {[0, 1].map(i => (
      <chip key={i} name={`JFAN${i + 1}`} footprint="pinrow4" pcbX={80 + i * 20} pcbY={-160} schX={5 + i} schY={9} />
    ))}
    <trace from=".UAUX > .GATE" to=".TAUX > .P2" />
    <trace from=".TAUX > .P1" to="net.DCP" />
  </board>
);

const XfmrAux = () => (
  <footprint>
    {[0, 1, 2, 3, 4, 5].map(i => (
      <platedhole key={i} portHints={[`pin${i + 1}`]} pcbX={-7.5 + (i % 3) * 7.5} pcbY={i < 3 ? -6 : 6} holeDiameter="1.1mm" outerDiameter="2mm" shape="circle" />
    ))}
  </footprint>
);
